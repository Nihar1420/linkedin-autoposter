# Copy this file to .env and fill it in.

# Claude API key, from https://platform.claude.com
ANTHROPIC_API_KEY=

# Or use Grok instead: if this is set, the app uses Grok. Keys come from
# https://console.x.ai
XAI_API_KEY=

# LinkedIn app credentials, from https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Safety switch. While this is true, nothing is sent to LinkedIn: posts are
# only marked as published inside the app. Set it to false when you are ready.
LINKEDIN_DRY_RUN=true

# Where the app lives. LinkedIn sends you back to APP_URL/auth/linkedin/callback.
APP_URL=http://localhost:3000
PORT=3000

# Required when the app is on the internet. You enter it once, when you create
# the first login (yours). After that everyone signs in with their own password.
SETUP_CODE=

# Optional settings
# CLAUDE_MODEL=claude-sonnet-5-5
# Most the app may spend on Claude per month, in dollars. 0 turns the limit off.
# MONTHLY_BUDGET_USD=3
# GROK_MODEL=grok-4.7
# DATA_DIR=./data
# LINKEDIN_API_VERSION=202610
